# Copy to .env and fill the values. Never commit .env.
PORT=8787
HOST=127.0.0.1
PHP_PORT=8788
PHP_HOST=127.0.0.1

# Defaults resolve to ../../ and ./data relative to this directory.
# ZC_WORKSPACE=/absolute/workspace
# ZC_PROJECTS_DIR=/absolute/workspace/php/workspaces
# DATA_DIR=/absolute/workspace/php/data

# false: no admin token check. true: require ADMIN_TOKEN.
ADMIN_TOKEN_ENABLED=false
ADMIN_TOKEN=replace-with-a-long-random-token

# OpenAI-compatible free alias endpoint.
IEZ_BASE_URL=https://api.infiniteearningzone.com/v1
IEZ_API_KEY=
IEZ_DEFAULT_MODEL=mission
IEZ_MODELS=mission,code-guru,bug-hunter,security-hero,perf-wizard,doc-king,qa-tyrant,team-heart,customer-experience-specialist,ecommerce-operations-analyst
IEZ_MCP_URL=https://api.infiniteearningzone.com/mcp
IEZ_MCP_NAME=InfiniteEarningZone MCP
IEZ_MCP_ENABLED=false
IEZ_MCP_CONNECT=true

# NVIDIA API Catalog as custom:nvidia.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_DEFAULT_MODEL=meta/muse-glimmer-30b
NVIDIA_MODELS=meta/muse-glimmer-30b,minimaxai/minimax-m3.1-flash,z-ai/glm-5.3-flash

# System identity.
ZC_IDENTITY_NAME=ZombieCoder
ZC_IDENTITY_VERSION=1.0.0
ZC_IDENTITY_TAGLINE=যেখানে কোড ও কথা বলে
ZC_IDENTITY_POWERED_BY=ZombieCoder-by-SahonSrabon
ZC_IDENTITY_OWNER=Sahon Srabon
ZC_IDENTITY_ORG=Developer Zone
ZC_IDENTITY_ADDRESS=235 South Pirarbag, Amtala Bazar, Mirpur - 60 feet
ZC_IDENTITY_LOCATION=Dhaka, Bangladesh
ZC_IDENTITY_PHONE=+880 1323-626282
ZC_IDENTITY_EMAIL=infi@zombiecoder.my.id
ZC_IDENTITY_WEBSITE=https://zombiecoder.my.id/
